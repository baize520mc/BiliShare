<Window
    x:Class="BiliShare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="一个神秘的Bilibili客户端">

    <Grid x:Name="RootGrid" Background="{StaticResource BrandWindowBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><!-- 标签栏 -->
            <RowDefinition Height="Auto"/><!-- 导航工具栏 -->
            <RowDefinition Height="*"/><!-- WebView2 内容区 -->
        </Grid.RowDefinitions>

        <!-- 顶部粉→蓝 品牌强调条 -->
        <Rectangle Grid.RowSpan="3" Height="3" VerticalAlignment="Top"
                   Fill="{StaticResource BrandTopAccentBrush}" IsHitTestVisible="False"/>

        <!-- ============ 标签栏 ============ -->
        <Grid x:Name="TabBarArea" Grid.Row="0" Height="34" Padding="8,4,0,4"
              Background="{StaticResource BrandSurfaceAltBrush}"
              BorderBrush="{StaticResource BrandBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 新建标签 -->
            <Button x:Name="AddTabButton"
                    Style="{StaticResource BrandIconButtonStyle}"
                    Click="AddTabButton_Click"
                    Width="30" Height="26" CornerRadius="7"
                    ToolTipService.ToolTip="新建标签">
                <FontIcon Glyph="&#xE710;" FontSize="12"/>
            </Button>

            <!-- 标签条（左对齐自适应，空白区留给标签栏作为拖拽手柄） -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" Margin="6,0,0,0"
                          HorizontalAlignment="Left">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="4"/>
            </ScrollViewer>

            <!-- 窗口控制按钮（隐藏系统标题栏后自定义） -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource BrandIconButtonStyle}"
                        Click="MinimizeButton_Click"
                        Width="40" Height="26" Padding="0" CornerRadius="7"
                        ToolTipService.ToolTip="最小化">
                    <FontIcon Glyph="&#xE921;" FontSize="11"/>
                </Button>
                <Button x:Name="MaxRestoreButton"
                        Style="{StaticResource BrandIconButtonStyle}"
                        Click="MaxRestoreButton_Click"
                        Width="40" Height="26" Padding="0" CornerRadius="7"
                        ToolTipService.ToolTip="最大化 / 还原">
                    <FontIcon x:Name="MaxRestoreIcon" Glyph="&#xE922;" FontSize="11"/>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource BrandWindowCloseButtonStyle}"
                        Click="CloseButton_Click"
                        CornerRadius="7" Padding="0"
                        ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="11"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 导航工具栏 ============ -->
        <Grid x:Name="ToolbarArea" Grid.Row="1" Height="42" Padding="10,4"
              Background="{StaticResource BrandSurfaceBrush}"
              BorderBrush="{StaticResource BrandBorderBrush}"
              BorderThickness="0,0,0,1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click"
                    Style="{StaticResource BrandNavButtonStyle}"
                    IsEnabled="False" ToolTipService.ToolTip="后退">
                <FontIcon Glyph="&#xE72B;" FontSize="13"/>
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Click="ForwardButton_Click"
                    Style="{StaticResource BrandNavButtonStyle}"
                    IsEnabled="False" ToolTipService.ToolTip="前进">
                <FontIcon Glyph="&#xE72A;" FontSize="13"/>
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshButton_Click"
                    Style="{StaticResource BrandNavButtonStyle}" ToolTipService.ToolTip="刷新">
                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
            </Button>
            <Button x:Name="HomeButton" Grid.Column="3" Click="HomeButton_Click"
                    Style="{StaticResource BrandHomeButtonStyle}" ToolTipService.ToolTip="主页">
                <FontIcon Glyph="&#xE80F;" FontSize="13"/>
            </Button>

            <!-- 只读地址栏（胶囊，磨砂态） -->
            <Border Grid.Column="4" Margin="10,0"
                    Height="30" VerticalAlignment="Center"
                    Background="#12FFFFFF" CornerRadius="15"
                    BorderBrush="{StaticResource BrandBorderStrongBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="11"
                              Foreground="{StaticResource BrandPinkBrush}"
                              Margin="12,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AddressBar" Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Margin="0,1,0,0"
                               FontSize="12"
                               Foreground="{StaticResource BrandTextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="阅读浏览 · 点触即达" />
                </Grid>
            </Border>

            <!-- 状态灯 -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                        Margin="8,0,6,0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="连接 / Cookie 状态">
                <Ellipse x:Name="StatusLight" Width="9" Height="9" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush x:Name="StatusLightBrush">
                            <GradientStop Color="#7A5EFF" Offset="0.0"/>
                            <GradientStop Color="#FFE7568B" Offset="0.55"/>
                            <GradientStop Color="#FF171614" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Text="未连接" FontSize="11"
                           Foreground="{StaticResource BrandTextMutedBrush}"/>
            </StackPanel>

            <!-- 设置 -->
            <Button x:Name="SettingsButton" Grid.Column="6" Click="SettingsButton_Click"
                    Style="{StaticResource BrandNavButtonStyle}"
                    Margin="6,0,0,0" ToolTipService.ToolTip="设置 (⚙)">
                <FontIcon Glyph="&#xE713;" FontSize="13"/>
            </Button>
        </Grid>

        <!-- ============ WebView2 内容区 ============ -->
        <Grid Grid.Row="2" x:Name="WebViewHost" Background="#FF121110"/>
    </Grid>
</Window>