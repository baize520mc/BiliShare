<Window
    x:Class="BiliShare.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="登录 B 站">

    <Grid x:Name="RootGrid" Background="{ThemeResource BrandWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部提示条 -->
        <Border Grid.Row="0" Background="{ThemeResource BrandSurfaceAltBrush}"
                BorderBrush="{ThemeResource BrandBorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource BrandTextBrush}"/>
                    <TextBlock Text="请使用密码或手机验证码登录，登录成功后会自动捕获 Cookie 并关闭此窗口"
                               FontSize="12" Foreground="{ThemeResource BrandTextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="LoginHint"
                           Text="未捕获到 refresh_token，将重新开始登录流程，请重新登录"
                           FontSize="12" Foreground="{ThemeResource BrandDangerBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- WebView2 登录页 -->
        <Grid Grid.Row="1">
            <WebView2 x:Name="WebView"/>
        </Grid>
    </Grid>
</Window>
